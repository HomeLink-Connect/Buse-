rules_version = '2';
// Offrez rules for the original collections. Paste in Firebase console > Firestore > Rules > Publish.
// Your separate verification system should use the Firebase Admin SDK (it bypasses these rules)
// to read vfiles and to set landlords/{id}.verified = true.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine(id) { return signedIn() && request.auth.uid == id; }
    function verifiedMail() { return signedIn() && request.auth.token.email_verified == true; }

    match /students/{id} {
      allow read: if signedIn();
      allow create, update: if mine(id);
    }
    match /landlords/{id} {
      allow read: if signedIn();
      allow create: if mine(id) && request.resource.data.verified == false;
      allow update: if mine(id) && request.resource.data.verified == resource.data.verified;
    }
    // Identity documents: only the landlord can write them; only the Admin SDK (your other system) can read them.
    match /vfiles/{id} {
      allow create, update: if signedIn() && request.resource.data.landlordId == request.auth.uid;
      allow read: if signedIn() && resource.data.landlordId == request.auth.uid;
      allow delete: if false;
    }
    match /properties/{id} {
      allow read: if signedIn();
      allow create: if verifiedMail() && request.resource.data.landlordId == request.auth.uid;
      allow update, delete: if verifiedMail() && resource.data.landlordId == request.auth.uid;
    }
    match /bookings/{id} {
      allow read: if signedIn();
      allow create: if verifiedMail() && request.resource.data.studentId == request.auth.uid;
      allow update: if verifiedMail() && (resource.data.studentId == request.auth.uid || resource.data.landlordId == request.auth.uid);
    }
    match /messages/{id} {
      allow read: if signedIn() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if verifiedMail() && request.resource.data.fromId == request.auth.uid;
      allow update: if verifiedMail() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }
    match /reviews/{id} { allow read: if signedIn(); allow create, update: if verifiedMail() && request.resource.data.studentId == request.auth.uid; }
    match /payments/{id} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || resource.data.landlordId == request.auth.uid);
      allow create: if verifiedMail() && request.resource.data.studentId == request.auth.uid;
    }
  }
}
